{
  "name": "claude-island",
  "productName": "Claude Island",
  "version": "0.4.0",
  "description": "Schwebende Insel, die Claude-Code-Sitzungen anzeigt und steuert.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "local.claude-island",
    "productName": "Claude Island",
    "publish": [
      {
        "provider": "github",
        "owner": "xxneoenxx",
        "repo": "Agents",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Claude-Island-Setup.${ext}",
      "differentialPackage": false
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "portable": {
      "artifactName": "Claude-Island-Portable.${ext}"
    }
  }
}
