# /etc/memecoin-bot.env – wird von install.sh angelegt (Rechte 600, nur root lesbar).
# Änderungen danach mit: sudo systemctl restart memecoin-recorder

# Telegram (Alarme + tägliches Lebenszeichen)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: eigener kostenloser Solana-Knoten, falls der öffentliche deine Server-IP drosselt,
# z. B. von helius.dev (Free-Plan): https://mainnet.helius-rpc.com/?api-key=DEIN_KEY
#SOLANA_RPC_URL=
#SOLANA_WS_URL=

# Optional: Totmannschalter, z. B. https://hc-ping.com/<deine-id> (healthchecks.io, kostenlos)
#HEALTHCHECK_URL=

# Jede Einstellung aus config.example.toml geht auch so:
#MEMECOIN_BOT__RECORDER__KEEP_DAYS=30
#MEMECOIN_BOT__OPS__HEARTBEAT_TIME=09:00
